# ============================================================
# Quota — AI Cost Control Layer
# Environment Configuration
# ============================================================

# Server
PORT=3100
NODE_ENV=development
LOG_LEVEL=debug

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Redis (optional — falls back to in-memory LRU cache)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Cache
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000

# Policy Defaults
DEFAULT_MAX_TOKENS_PER_REQUEST=100000
DEFAULT_MAX_OUTPUT_TOKENS=4096
DEFAULT_BUDGET_PER_KEY_DAILY_USD=50.00
DEFAULT_MODEL=claude-sonnet-4-6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Optimization
AUTO_SUMMARIZE_THRESHOLD_TOKENS=50000
DEDUP_WINDOW_SECONDS=300
PROMPT_TRIM_ENABLED=true
